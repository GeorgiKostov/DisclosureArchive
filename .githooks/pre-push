#!/bin/sh
set -eu

remote_name="${1:-}"
publish_main="0"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    publish_main="1"
  fi
done

if [ "${DISCLOSURE_SKIP_PAGES_PUBLISH:-}" = "1" ]; then
  echo "DisclosureArchive: skipping Pages publish because DISCLOSURE_SKIP_PAGES_PUBLISH=1."
  exit 0
fi

if [ "$remote_name" != "origin" ] || [ "$publish_main" != "1" ]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
db_path="$repo_root/indexes/uap_release.sqlite"
publish_script="$repo_root/scripts/publish_github_pages.ps1"

if [ ! -f "$db_path" ]; then
  echo "DisclosureArchive: skipping Pages publish; missing $db_path."
  exit 0
fi

if [ ! -f "$publish_script" ]; then
  echo "DisclosureArchive: skipping Pages publish; missing $publish_script."
  exit 0
fi

echo "DisclosureArchive: publishing GitHub Pages before pushing main."

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -File "$publish_script"
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$publish_script"
elif command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -ExecutionPolicy Bypass -File "$publish_script"
else
  echo "DisclosureArchive: PowerShell was not found; run scripts/publish_github_pages.ps1 manually."
  exit 1
fi
